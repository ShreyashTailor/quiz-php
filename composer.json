{
    "name": "quizmaster/quizmaster",
    "description": "QuizMaster - Interactive Learning Platform",
    "type": "project",
    "license": "Apache-2.0",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.3",
        "ext-mysqli": "*",
        "ext-json": "*",
        "ext-session": "*",
        "ext-fileinfo": "*",
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-mbstring": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^3.8",
        "phpstan/phpstan": "^1.11"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {}
    },
    "autoload": {
        "psr-4": {
            "QuizMaster\\": "src/"
        },
        "files": [
            "config.php",
            "security.php",
            "db.php"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "cs-check": "phpcs --standard=PSR12 src/",
        "cs-fix": "phpcbf --standard=PSR12 src/",
        "static-analysis": "phpstan analyse src/",
        "setup": "php setup.php",
        "migrate": "php update_db.php"
    }
}